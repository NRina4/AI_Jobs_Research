APP_NAME=AI Jobs Research
APP_ENV=development
DEBUG=true

# Local run
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_jobs_db

# Docker Compose overrides DATABASE_URL for the app service:
# postgresql+psycopg://postgres:postgres@db:5432/ai_jobs_db

POSTGRES_DB=ai_jobs_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
APP_PORT=8000

DATASET_PATH=data/global_ai_jobs_2026.csv
LOG_LEVEL=INFO
